API_BASE = 'http://localhost:5000'


def generate_container_name(include_number=False):
    adjectives = [
        "brave", "calm", "clever", "eager", "gentle", 
        "happy", "noble", "rapid", "silent", "wild",
        "mighty", "fancy", "bright", "cool", "epic"
    ]
    
    nouns = [
        "tiger", "panda", "falcon", "python", "nebula", 
        "photon", "comet", "lotus", "vertex", "aurora",
        "titan", "eagle", "galaxy", "vertex", "sparrow"
    ]
    
    name = f"{random.choice(adjectives)}_{random.choice(nouns)}"
    
    # Optionally append a random number like Docker does (e.g., "quirky_fermi_42")
    if include_number:
        name += f"_{random.randint(1, 9999)}"
    
    return name



def classify_mount(mount_str):
    """
    Determine whether a Docker '-v' / '--mount' style mount string represents:
    - a bind mount
    - or a named volume

    Logic:
      Linux/Mac:
        - bind mount if the source contains '/' or starts with '.' (relative path)
        - else volume

      Windows:
        - bind mount if source looks like 'C:\\path' or contains '\\' or '/'
        - else volume
    """

    # Extract the source part (left of first ':')
    parts = mount_str.split(':')
    if len(parts) < 2:
        raise ValueError("Invalid Docker mount string (missing ':')")

    source = parts[0]
    system = platform.system()

    # -----------------------
    # LINUX / MAC LOGIC
    # -----------------------
    if system in ("Linux", "Darwin"):
        # Absolute path
        if source.startswith('/'):
            return "bind"

        # Relative path (e.g., './data', 'data/subdir')
        if source.startswith('.') or '/' in source:
            return "bind"

        # Anything else is treated as a named volume
        return "volume"

    # -----------------------
    # WINDOWS LOGIC
    # -----------------------
    elif system == "Windows":
        # Windows absolute path: C:\something OR C:/something
        if re.match(r"^[A-Za-z]:[\\/]", source):
            return "bind"

        # Windows UNC paths: \\Server\Dir
        if source.startswith('\\\\'):
            return "bind"

        # Path containing slashes also indicates bind
        if '\\' in source or '/' in source:
            return "bind"

        # Otherwise → named volume
        return "volume"

    # -----------------------
    # UNKNOWN OS → fallback to Linux rules
    # -----------------------
    else:
        return "bind" if '/' in source else "volume"


# Helper functions
def list_containers(all=False):
    if all:
        containers = r.get(f"{API_BASE}/api/container").json()
    else:
        containers = r.get(f"{API_BASE}/api/container?running=True").json()
    print("CONTAINER ID   NAME     STATUS")
    for container in containers:
        if all or container["status"] == "running":
            print(f"{container['id']:13} {container['name']:8} {container['status']}")

def list_networks():
    networks = r.get(f"{API_BASE}/api/networks").json()
    print("NETWORK ID     NAME                   DRIVER               ")
    for network in networks:
        print(f"{network['id']:13} {network['name']:25} {network['driver']:25}")

def list_volumes():
    volumes = r.get(f"{API_BASE}/api/volumes").json()
    print(f"{'ID':13} {'NAME'}")
    for volume in volumes:
        print(f"{volume['id']:13} {volume['name']}")

def list_images():
    images = r.get(f"{API_BASE}/api/images").json()
    print(f"{'NAME':25}{'TAG':25}{'CREATED_AT'}")
    for img in images:
        print(f"{img['name']:25}{img['tag']:25}{img['created_at']}")

def prestart_container(name):
    res = r.get(f'{API_BASE}/api/container/{name}')
    if res.status_code == 404:
        print(f"Container {name} doesn't found")
        exit(-1)
    container = res.json()
    for network in container.get('networks',[]):
        if network['name'] == 'host':
            continue
        start_network(network['name'])
        print(f'Started Network {network["name"]}')


    
def start_container(name):
    prestart_container(name)
    res = r.post(f'{API_BASE}/api/container/{name}/start')
    if res.status_code == 404:
        print(f"Container {name} doesn't found")
        return
    container = res.json()
    print("NAME        STATUS ")
    print(f"{container['container']:15} {container['status']:15}")

def stop_container(name):
    res = r.post(f'{API_BASE}/api/container/{name}/stop')
    if res.status_code == 404:
        print(f"Container {name} doesn't found")
        return
    container = res.json()
    print("NAME        STATUS ")
    print(f"{container['container']:15} {container['status']:15}")


def handle_networks_create(args):
    data = {}
    print(f"Creating network '{args.name}' with the following settings:")
    print(f"  Driver:  {args.driver}")
    data['name'] = args.name
    data['driver'] = args.driver
    if args.subnet:
        print(f"  Subnet:  {args.subnet}")
        data['subnet'] = args.subnet
    if args.gateway:
        print(f"  Gateway: {args.gateway}")
        data['gateway'] = args.gateway
    res = r.post(f'{API_BASE}/api/networks', json=data)
    data = res.json()
    if res.status_code>=400:
        print(f"Failed to create network: {data['error']}")
        return
    print("NAME         Subnet")
    print(f"{data['name']:15} {data['subnet']}")


def start_network(name):
    res = r.post(f'{API_BASE}/api/networks/{name}/start')
    if res.status_code == 400:
        print(f"Network {name} not found")
        return 
    print(f"{'NAME':10}Status\n{name:10}STARTED")

def create_volume(args):
    print(args.name)
    res = r.post(f'{API_BASE}/api/volumes', json={"name":args.name})
    if res.status_code != 201:
        print(res.content)
        return -1
    data = res.json()
    print(data)
    print(f"{'ID':5}{'NAME'}\n{data['ID']:5}{data['name']}")
    return 0

def create_container(args):
    # print(args)
    # return
    if not args.image:
        print('Image cannot be null')
        return -1
    

    data = {}
    if args.name:
        data['name'] = args.name
    else:
        data['name'] = generate_container_name()
    
    data['image'] = args.image
    if args.cmd:
        data['command'] = args.cmd

    envs = {}
    for env in args.env:
        key, value = env.split('=')
        envs[key] = value
    
    data['env'] = envs
    

    if args.workdir:
        data['workingDir'] = args.workdir
    
    if args.network:
        data['networks'] = args.network
    
    ports = []
    if args.publish and len(args.publish)>0:
        for port in args.publish:
            host, container = port.split(':')
            container = container.split('/')
            p = {}
            p['host'] = int(host)
            p['container'] = int(container[0])
            p['proto'] = 'tcp'
            if len(container)>1:
                if container[1] not in ('tcp', 'udp'):
                    print('Unsupported protocal', container[1])
                    return -1
                p['proto'] = container[1]
            ports.append(p)
    
    if ports:
        data['ports'] = ports

    volumes = {}
    for v in args.volume:
        vol = v.split(':')
        if len(vol)<2:
            print('Invalid Volume mount configuration', v)
            return -1
        mount_type = classify_mount(v)
        if mount_type == 'volume':
            key = vol[0]
            create_volume(SimpleNamespace(name=key))
        else:
            key = os.path.abspath(vol[0])
        
        volumes[key] ={
                'type': mount_type,
                'source':vol[1],
                'readonly': False
            }
        if len(vol) == 3:
            if vol[2] == '':
                continue
            
            elif vol[2] not in ('ro', 'rw'):
                print(f'Invalid Mount flag "{vol[2]}" Valid values are among (ro, rw). Defaults to "rw"')
                return -1
            volumes[key]['readonly'] = vol[2]=='ro' 
    data['mounts'] = volumes
    data['restart'] = args.restart
    data['rm'] = args.rm
    # print(json.dumps(data, indent=4))    
    res = r.post(f'{API_BASE}/api/containers', json=data)
    if res.status_code != 201:
        print("Failed to create container:", res.content)
        return -1
    cont = res.json()
    print(f"{'ID':5} NAME\n{cont['id']:5} {data['name']}")

    

def get_container(args):
    res = r.get(f'{API_BASE}/api/container/{args.name}')
    if res.status_code!=200:
        print(res.content)
        return -1    
    data = res.json()
    print(json.dumps(data, indent=4))
    return 0


    

# Main CLI
def main():
    parser = argparse.ArgumentParser(prog="dockermock", description="Mock Docker CLI Tool")
    subparsers = parser.add_subparsers(dest="command")

    # container ps
    container_parser = subparsers.add_parser("container", help="Manage containers")
    container_subparsers = container_parser.add_subparsers(dest="subcommand")

    ps_parser = container_subparsers.add_parser("ps", help="List containers")
    ps_parser.add_argument("--all", action="store_true", help="Show all containers (default shows just running)")

    start_parser = container_subparsers.add_parser("start", help="Start a container")
    start_parser.add_argument("name", help="ID of the container to start")



    stop_parser = container_subparsers.add_parser("stop", help="Start a container")
    stop_parser.add_argument("name", help="ID of the container to start")

    # ----------------------------------------------------
    # docker container create  
    # ----------------------------------------------------
    create_cont_parser = container_subparsers.add_parser("create", help="Create a new container")

    # name
    create_cont_parser.add_argument("--name", help="Assign a name to the container")

    # env vars
    create_cont_parser.add_argument("-e", "--env", action="append",
                           help="Set environment variables (KEY=VALUE)")

    # ports
    create_cont_parser.add_argument("-p", "--publish", action="append",
                           help="Publish a container's port(s) to the host")

    # volumes
    create_cont_parser.add_argument("-v", "--volume", action="append",
                           help="Bind mount a volume")

    # working directory
    create_cont_parser.add_argument("-w", "--workdir",
                           help="Working directory inside the container")

    # user
    create_cont_parser.add_argument("-u", "--user",
                           help="Username or UID")

    # restart policy
    create_cont_parser.add_argument("--restart", default='no',
                           help="Restart policy (no, on-failure, always, unless-stopped)")

    # auto-remove on exit
    create_cont_parser.add_argument("--rm", action="store_true",
                           help="Automatically remove container when it exits")

    # Attach Container to network
    create_cont_parser.add_argument("-n", "--network", action="append",
                           help="Attach Container network")


    # the container image
    create_cont_parser.add_argument("image", help="Image to use for the container")

    # optional command + args
    create_cont_parser.add_argument("cmd", nargs=argparse.REMAINDER,
                           help="Command to run inside the container")
    
    create_cont_parser.set_defaults(func=create_container)

    cont_inspect_parser = container_subparsers.add_parser("inspect", help="Get Container Config")
    cont_inspect_parser.add_argument("name", help="ID of the container to inspect")
    cont_inspect_parser.set_defaults(func=get_container)
    # ----------------------------------------------------
    # docker images  
    # ----------------------------------------------------
    image_parser = subparsers.add_parser("images", help="Manage images")
    image_subparsers = image_parser.add_subparsers(dest="subcommand")
    image_subparsers.add_parser("ls", help="List Images")

    # ----------------------------------------------------
    # docker networks
    # ----------------------------------------------------
    
    networks_parser = subparsers.add_parser("networks", help="Manage networks")
    networks_subparsers = networks_parser.add_subparsers(dest="subcommand")
    networks_subparsers.add_parser("ls", help="List networks")
    networks_start_parser = networks_subparsers.add_parser("start", help="Start a network")
    networks_start_parser.add_argument("name", help="Name of the network to start")
    networks_start_parser.set_defaults(func=start_network)

    create_parser = networks_subparsers.add_parser("create", help="Create a new network")
    create_parser.add_argument("name", help="Name of the network to create")
    create_parser.add_argument("--driver", "-d", default="bridge", help="Network driver (default: bridge)")
    create_parser.add_argument("--subnet", help="Subnet in CIDR format (e.g., 192.168.1.0/24)")
    create_parser.add_argument("--gateway", help="Gateway for the subnet")
    create_parser.set_defaults(func=handle_networks_create)

    # ----------------------------------------------------
    # docker volumes create  
    # ----------------------------------------------------
    volumes_parser = subparsers.add_parser("volumes", help="Manage volumes")
    volumes_subparsers = volumes_parser.add_subparsers(dest="subcommand")
    volumes_subparsers.add_parser("ls", help="List volumes")
    volume_create_parser = volumes_subparsers.add_parser("create", help="Create new Volume")
    volume_create_parser.add_argument("--name", required=True, help="Volume name")
    volume_create_parser.set_defaults(func=create_volume)

    

    args = parser.parse_args()

    if args.command == "container": 
        if args.subcommand == "ps":
            list_containers(all=args.all)
        elif args.subcommand == "start":
            start_container(args.name)
        elif args.subcommand == "stop":
            stop_container(args.name)
        elif args.subcommand == "create":
            args.func(args)
        elif args.subcommand == "inspect":
            args.func(args)
        else:
            container_parser.print_help()
        
    elif args.command == "networks":
        if args.subcommand == "ls":
            list_networks()
        elif args.subcommand == "create":
            args.func(args)
        elif args.subcommand == "start":
            args.func(args.name)

    elif args.command == "images":
        if args.subcommand == "ls":
            list_images()

    elif args.command == "volumes" and args.subcommand == "ls":
        list_volumes()
    elif args.command == "volumes" and args.subcommand == "create":
        args.func(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
